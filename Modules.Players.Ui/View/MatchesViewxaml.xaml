<UserControl x:Class="Modules.Matches.Ui.View.MatchesViewxaml"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Modules.Matches.Ui.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="900">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Forma za unos i izmenu meča -->
        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,15">
            <TextBlock Text="Upravljanje mečevima" FontSize="18" Foreground="White" FontWeight="Bold" Margin="0,0,0,10"/>

            <UniformGrid Columns="5" Margin="0,0,0,10">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Home Team ID:"/>
                    <TextBox Text="{Binding HomeTeamId, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Away Team ID:"/>
                    <TextBox Text="{Binding AwayTeamId, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Home Score:"/>
                    <TextBox Text="{Binding HomeScore, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Away Score:"/>
                    <TextBox Text="{Binding AwayScore, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Match Date:"/>
                    <DatePicker SelectedDate="{Binding MatchDate}" Margin="0,5,0,0"/>
                </StackPanel>
            </UniformGrid>

            <!-- Dugmad za akcije -->
            <StackPanel Orientation="Horizontal">
                <Button Content="Dodaj meč" 
                        Command="{Binding AddMatchCommand}" 
                        Width="120" Height="30" Margin="0,0,10,0" Background="#4CAF50" Foreground="White"/>
                <Button Content="Ažuriraj" 
                        Command="{Binding UpdateMatchCommand}" 
                        Width="120" Height="30" Margin="0,0,10,0" Background="#2196F3" Foreground="White"/>
                <Button Content="Obriši" 
                        Command="{Binding DeleteMatchCommand}" 
                        Width="120" Height="30" Background="#F44336" Foreground="White"/>
            </StackPanel>
        </StackPanel>

        <!-- Prikaz liste mečeva u DataGrid-u sa selekcijom -->
        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding Matches}" 
                  SelectedItem="{Binding SelectedMatch, Mode=TwoWay}"
                  AutoGenerateColumns="True" 
                  IsReadOnly="True" 
                  SelectionMode="Single"
                  BorderBrush="#ccc" BorderThickness="1"/>
    </Grid>
</UserControl>