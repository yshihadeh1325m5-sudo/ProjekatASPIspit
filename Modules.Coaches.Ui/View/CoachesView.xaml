<UserControl x:Class="Modules.Coaches.Ui.View.CoachesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="950"
             Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Upravljanje Trenerima" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Margin="0,0,0,20"/>

        <!-- Tabela -->
        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding CoachesItems}" 
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False"
                  Margin="0,0,0,20">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="220" IsReadOnly="True"/>
                <DataGridTextColumn Header="Ime" Binding="{Binding Ime, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="Prezime" Binding="{Binding Prezime, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="Licenca" Binding="{Binding Licenca, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                <DataGridTextColumn Header="Opis Licence" Binding="{Binding OpisLicence, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="Ekipa" Binding="{Binding Ekipa, UpdateSourceTrigger=PropertyChanged}" Width="*"/>

                <DataGridTemplateColumn Header="Akcije" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Ažuriraj" 
                                        Command="{Binding DataContext.UpdateCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        Margin="0,0,5,0"/>

                                <Button Content="Obriši" 
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding Id}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Forma za unos na dnu -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock Text="Ime:" VerticalAlignment="Center" Margin="5"/>
            <TextBox Text="{Binding Ime, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="5" VerticalAlignment="Center"/>

            <TextBlock Text="Prezime:" VerticalAlignment="Center" Margin="10,5,5,5"/>
            <TextBox Text="{Binding Prezime, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="5" VerticalAlignment="Center"/>

            <TextBlock Text="Licenca:" VerticalAlignment="Center" Margin="10,5,5,5"/>
            <TextBox Text="{Binding Licenca, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="5" VerticalAlignment="Center"/>

            <TextBlock Text="Opis:" VerticalAlignment="Center" Margin="10,5,5,5"/>
            <TextBox Text="{Binding OpisLicence, UpdateSourceTrigger=PropertyChanged}" Width="110" Margin="5" VerticalAlignment="Center"/>

            <TextBlock Text="Ekipa:" VerticalAlignment="Center" Margin="10,5,5,5"/>
            <TextBox Text="{Binding Ekipa, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="5" VerticalAlignment="Center"/>

            <Button Content="Dodaj Novog Trenera" 
                    Command="{Binding DodajCommand}" 
                    Width="140" 
                    Margin="15,5,5,5" 
                    VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>