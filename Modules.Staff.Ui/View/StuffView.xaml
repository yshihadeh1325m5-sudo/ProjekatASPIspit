<UserControl x:Class="Modules.Stuff.Ui.View.StuffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Modules.Stuff.Ui.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="950"
             Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Upravljanje stvarima" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Margin="0,0,0,20"/>

        <!-- Tabela sa eksplicitnim kolonama i akcijama u redu -->
        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding StuffItems}" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False"
                  Margin="0,0,0,20">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="220" IsReadOnly="True"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="Code" Binding="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="Price" Binding="{Binding Price, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="*"/>

                <DataGridTemplateColumn Header="Akcije" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Ažuriraj" 
                                        Command="{Binding DataContext.UpdateCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding}" 
                                        Margin="0,0,5,0"/>

                                <Button Content="Obriši" 
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding Id}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Forma za unos na dnu -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock Text="Name:" VerticalAlignment="Center" Margin="5"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="110" Margin="5" VerticalAlignment="Center"/>

            <TextBlock Text="Code:" VerticalAlignment="Center" Margin="10,5,5,5"/>
            <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="5" VerticalAlignment="Center"/>

            <TextBlock Text="Price:" VerticalAlignment="Center" Margin="10,5,5,5"/>
            <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="5" VerticalAlignment="Center"/>

            <TextBlock Text="Description:" VerticalAlignment="Center" Margin="10,5,5,5"/>
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="110" Margin="5" VerticalAlignment="Center"/>

            <Button Content="Dodaj Novu Stvar" 
                    Command="{Binding DodajCommand}" 
                    Width="130" 
                    Margin="15,5,5,5" 
                    VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>